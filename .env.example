# ==============================================================================
# SOHOJ JATRA - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. Supabase Cloud Configuration (Required for live multi-computer sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. bKash Tokenized Checkout (Sandbox / Live)
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password

# 3. Nagad Direct Checkout
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_PRIVATE_KEY=your_nagad_private_key
NAGAD_PUBLIC_KEY=your_nagad_public_key

# 4. SSLCommerz Gateway
SSLC_STORE_ID=your_sslc_store_id
SSLC_STORE_PASSWD=your_sslc_store_password

# 5. SMS & Notification Webhook (Twilio / Greenweb BD)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number
BD_SMS_API_TOKEN=your_greenweb_or_bulksms_token
